<!-- Sub menu of the iOS style power menu, e.g. the advanced restart options. The rows are added at
     runtime, one SlideToActView per action, because how many there are depends on what the device
     supports. -->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/global_actions_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:id="@+id/power_menu_ios_submenu_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingStart="@dimen/power_menu_ios_row_margin_horizontal"
        android:paddingEnd="@dimen/power_menu_ios_row_margin_horizontal" />

    <ImageView
        android:id="@+id/power_menu_ios_close"
        android:layout_width="@dimen/power_menu_ios_close_size"
        android:layout_height="@dimen/power_menu_ios_close_size"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="@dimen/power_menu_ios_close_margin_bottom"
        android:background="@drawable/power_menu_ios_close_background"
        android:contentDescription="@string/power_menu_ios_close"
        android:padding="20dp"
        android:src="@drawable/ic_close"
        android:tint="@color/power_menu_ios_foreground" />
</FrameLayout>
